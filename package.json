{
  "name": "fliproom",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3117",
    "studio": "next dev --hostname localhost --port 3333",
    "build": "next build",
    "build:pages": "node scripts/build-pages.mjs",
    "start": "next start --hostname 127.0.0.1 --port 3117",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "seed:preview": "tsx scripts/seed.ts",
    "check:live": "tsx scripts/check-live.ts"
  },
  "dependencies": {
    "@sanity/client": "^8.6.2",
    "groq-js": "^2.0.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sanity": "^6.15.0",
    "styled-components": "^6.5.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@module-federation/dts-plugin": {
      "adm-zip": "0.6.1"
    },
    "@vercel/frameworks": {
