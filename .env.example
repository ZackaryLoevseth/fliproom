# Leave blank for the clearly labeled local demo. No Sanity account is required.
# After account/project approval, use a FREE public dataset and its real project ID.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=

# Optional appKey of the room to read; defaults to the room in src/lib/fixtures.ts.
SANITY_ROOM_KEY=

# No API token is needed or accepted by the public read path.
# Dataset import, Studio login, CORS changes and public hosting require approval.
